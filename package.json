{
  "name": "dsh-api-runner",
  "version": "0.3.4",
  "description": "DSH 插件：按配置调用后端 HTTP 接口、启停/重启本地开发服务、增量读取日志并等待日志特征，让模型能\"改完自己验\"。",
  "type": "module",
  "license": "MIT",
  "author": "Moz (lhhzmz229)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhhzmz229/dsh-api-runner.git"
  },
  "homepage": "https://github.com/lhhzmz229/dsh-api-runner#readme",
  "bugs": {
    "url": "https://github.com/lhhzmz229/dsh-api-runner/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "api-runner",
    "http-client",
    "log-tail",
    "spring-boot",
    "java",
    "devtools"
  ],
  "main": "src/main.js",
  "exports": {
    ".": "./src/main.js",
    "./runner": "./src/main.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.5",
    "dsh": ">=0.1.0-rc.6 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/plugin.mjs && node test/db.mjs && node test/security.mjs",
    "test:all": "node test/smoke.mjs && node test/plugin.mjs && node test/db.mjs && node test/security.mjs && node test/client.mjs && node test/managed.mjs && node test/java.mjs",
    "stage": "node scripts/stage.mjs",
    "release": "node scripts/stage.mjs --release",
    "check-leak": "node scripts/check-leak.mjs",
    "check-deps": "node scripts/check-deps.mjs",
    "prepublishOnly": "node scripts/check-leak.mjs && node scripts/check-deps.mjs"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "optionalDependencies": {
    "dmdb": "^1.0.52452",
    "mysql2": "^3.11.0",
    "pg": "^8.13.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "files": [
    "cordis.patch.yml",
    "src",
    "client",
    "docs",
    "scripts",
    "test",
    "README.md",
    "LICENSE",
    "dsh-api-runner.example.yml"
  ]
}
